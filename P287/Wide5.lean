theorem sqmul_step (g n v e_prev bit v_cur : ℕ) (h : g ^ e_prev % n = v)
    (hv : v ^ 2 % n * (g ^ bit % n) % n = v_cur) :
    g ^ (e_prev * 2 + bit) % n = v_cur := by
  rw [pow_add, pow_mul, Nat.mul_mod, Nat.pow_mod, h]
  exact hv

theorem cast_one {n a e : ℕ} (h : a ^ e % n = 1) : ((a : ZMod n)) ^ e = 1 := by
  have h2 : ((a ^ e % n : ℕ) : ZMod n) = ((1 : ℕ) : ZMod n) := by rw [h]
  rwa [ZMod.natCast_mod, Nat.cast_pow, Nat.cast_one] at h2

theorem cast_ne_one {n a e v : ℕ} (h : a ^ e % n = v) (hv : v ≠ 1) (hvlt : v < n) (hn1 : 1 < n) :
    ((a : ZMod n)) ^ e ≠ 1 := by
  intro hc
  apply hv
  have h1 : ((a ^ e % n : ℕ) : ZMod n) = (1 : ZMod n) := by
    rw [ZMod.natCast_mod, Nat.cast_pow]; exact hc
  rw [h] at h1
  haveI : Fact (1 < n) := ⟨hn1⟩
  have hv2 : (v : ZMod n).val = v := ZMod.val_cast_of_lt hvlt
  have h12 : (1 : ZMod n).val = 1 := ZMod.val_one n
  have hveq := congrArg ZMod.val h1
  rw [hv2, h12] at hveq
  exact hveq

theorem pow_mul_step (b e f n v w : ℕ) (h1 : b ^ e % n = v) (h2 : v ^ f % n = w) :
    b ^ (e * f) % n = w := by
  rw [pow_mul, Nat.pow_mod, h1, h2]

