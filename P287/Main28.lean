theorem erdos287_below {k : ℕ} (hk : 2 ≤ k) (s : Fin k → ℕ)
    (hmono : StrictMono s) (h1 : 1 < s ⟨0, by omega⟩)
    (hsum : ∑ i : Fin k, ((s i : ℚ))⁻¹ = 1)
    (hhi : s ⟨k - 1, by omega⟩ ≤ ) :
    3 ≤ PCI.max_gap k s := by
  by_cases b0 : s ⟨k - 1, by omega⟩ ≤ 
  · exact Main27.erdos287_below hk s hmono h1 hsum b0
  push_neg at b0
  by_cases b1 : s ⟨k - 1, by omega⟩ ≤ 
  · exact WideExt775.chunk_gap hk s hmono h1 hsum (by omega) b1
  push_neg at b1
  by_cases b2 : s ⟨k - 1, by omega⟩ ≤ 
  · exact WideExt776.chunk_gap hk s hmono h1 hsum (by omega) b2
  push_neg at b2
  by_cases b3 : s ⟨k - 1, by omega⟩ ≤ 
  · exact WideExt777.chunk_gap hk s hmono h1 hsum (by omega) b3
  push_neg at b3
  by_cases b4 : s ⟨k - 1, by omega⟩ ≤ 
  · exact WideExt778.chunk_gap hk s hmono h1 hsum (by omega) b4
  push_neg at b4
  omega

