  by_cases b4 : s ⟨k - 1, by omega⟩ ≤ 
  · exact WideExt135.chunk_gap hk s hmono h1 hsum (by omega) b4
  push_neg at b4
  by_cases b5 : s ⟨k - 1, by omega⟩ ≤ 
  · exact WideExt136.chunk_gap hk s hmono h1 hsum (by omega) b5
