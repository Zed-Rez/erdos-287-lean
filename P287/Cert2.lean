/- Certificate-carrying rungs of the #287 ladder, generated by
   attempts/013-certladder/gen_cert.py. Each rung supplies two Lucas
   certificates and instantiates StepA.step_gap once. -/
import P287.StepA
import Mathlib.NumberTheory.LucasPrimality
import Mathlib.Tactic.NormNum.Prime

namespace Cert2

theorem sq_step (b k n v : ℕ) (h : b ^ k % n = v) :
    b ^ (2 * k) % n = v * v % n := by
  rw [two_mul, pow_add, Nat.mul_mod, h]

theorem sqm_step (b k n v : ℕ) (h : b ^ k % n = v) :
    b ^ (2 * k + 1) % n = (v * v % n) * (b % n) % n := by
  rw [pow_succ, Nat.mul_mod, sq_step b k n v h]

theorem cast_one {b e n : ℕ} (h : b ^ e % n = 1) : ((b : ZMod n))^e = 1 := by
  have h1 : ((b ^ e % n : ℕ) : ZMod n) = ((b ^ e : ℕ) : ZMod n) := ZMod.natCast_mod _ _
  rw [h] at h1
  rw [← Nat.cast_pow, ← h1]
  norm_num

theorem cast_ne_one {b e n v : ℕ} (h : b ^ e % n = v) (hn : 1 < n)
    (hv : v ≠ 1) (hvn : v < n) : ((b : ZMod n))^e ≠ 1 := by
  intro hc
  have h1 : ((b ^ e % n : ℕ) : ZMod n) = ((b ^ e : ℕ) : ZMod n) := ZMod.natCast_mod _ _
  rw [h] at h1
  rw [← Nat.cast_pow] at hc
  rw [← h1] at hc
  have hval := congrArg ZMod.val hc
  rw [ZMod.val_cast_of_lt hvn] at hval
  have h1' : ((1:ℕ) : ZMod n) = (1 : ZMod n) := by norm_num
  rw [← h1', ZMod.val_cast_of_lt hn] at hval
  exact hv hval

